# Salin file ini menjadi .env lalu isi. File .env tidak ikut ke GitHub.

# Supabase: Project Settings > API Keys (dan Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=isi-dengan-secret-key

# Kunci perangkat: bebas, asal sama persis dengan DEVICE_KEY di firmware/include/secrets.h
DEVICE_KEY=ganti-dengan-kunci-acak
